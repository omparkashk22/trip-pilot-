rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for everything
    match /{document=**} {
      allow read, write: if false;
    }

    // config/plans: readable by any signed-in user, no client writes
    match /config/plans {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // config/payments: readable by any signed-in user, no client writes
    match /config/payments {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // config/private: strictly server-only
    match /config/private {
      allow read, write: if false;
    }

    // config/adminStats: read by admins only, no client writes
    match /config/adminStats {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // users/{uid}: read allowed only for the document owner, no client writes
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // payments/{requestId}: read allowed only for the payment owner, no client writes
    match /payments/{requestId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.token.admin == true
      );
      allow write: if false;
    }

    // Sensitive server-only collections: no client read or write
    match /deviceIds/{identifierHash} {
      allow read, write: if false;
    }

    match /trialEmails/{emailNormalized} {
      allow read, write: if false;
    }

    match /utrs/{utr} {
      allow read, write: if false;
    }

    match /auditLog/{logId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    match /redeemCodes/{code} {
      allow read, write: if false;
    }
  }
}
