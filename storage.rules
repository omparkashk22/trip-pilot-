rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Payment screenshots: upload only to payments/{uid}/{requestId}.(jpg|png)
    // No client reads: admins inspect via server-generated signed URLs.
    match /payments/{uid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource.contentType == 'image/jpeg' || request.resource.contentType == 'image/png')
        && request.resource.size <= 2 * 1024 * 1024
        && (fileName.matches('.*\\.jpg') || fileName.matches('.*\\.jpeg') || fileName.matches('.*\\.png'));
      allow read: if false;
    }
  }
}
